@model int
@{
    Layout = "_Layout";
    ViewData["Title"] = "Маршруты диалога";
}

<link rel="stylesheet" href="/dialogue-analysis.css">
<nav aria-label="Рабочая область">
  <a href="/">Каталог диалогов</a>
  <a href="/dialogues/@Model">Редактор диалога</a>
</nav>
<section id="analysis" data-dialogue-id="@Model" aria-labelledby="analysis-heading" hidden>
  <div class="actions analysis-heading">
    <h2 id="analysis-heading"></h2>
    <button type="button" id="refresh-analysis">Обновить отчёт</button>
  </div>
  <p id="analysis-notice" role="status" hidden></p>
  <dl id="analysis-metrics" class="analysis-metrics"></dl>
  <section class="analysis-section" aria-labelledby="analysis-endings-heading">
    <h3 id="analysis-endings-heading">Концовки</h3>
    <ul id="analysis-endings" class="analysis-rows"></ul>
    <div id="ending-route" class="ending-route" tabindex="-1" hidden>
      <h4 id="ending-route-title"></h4>
      <p id="ending-route-message"></p>
      <ol id="ending-route-steps"></ol>
    </div>
  </section>
  <div id="analysis-problems" hidden>
    <details class="analysis-section">
      <summary id="analysis-unreachable-title">Недостижимые реплики</summary>
      <ul id="analysis-unreachable" class="analysis-rows"></ul>
    </details>
    <details class="analysis-section">
      <summary id="analysis-unavailable-title">Недоступные переходы</summary>
      <ul id="analysis-unavailable" class="analysis-rows"></ul>
    </details>
    <details class="analysis-section">
      <summary id="analysis-trapped-title">Состояния без пути к концовке</summary>
      <ul id="analysis-trapped" class="analysis-rows"></ul>
    </details>
  </div>
</section>

@section Scripts {
    <script type="module" src="/dialogue-analysis.js"></script>
}
