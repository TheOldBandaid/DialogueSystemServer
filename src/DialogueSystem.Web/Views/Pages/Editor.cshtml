@model int
@{
    Layout = "_Layout";
    ViewData["Title"] = "Редактор диалога";
}

<nav aria-label="Рабочая область">
  <a href="/">Каталог диалогов</a>
  <a href="#dialogue">Редактирование</a>
  <a href="#preview">Предпросмотр</a>
</nav>
<div id="editor-content" data-dialogue-id="@Model" hidden>
  <h2 id="dialogue-title"></h2>
  <details>
    <summary>Создать персонажа</summary>
    <form id="new-character" class="actions">
      <label>Имя персонажа <input name="name" maxlength="120" required></label>
      <button>Создать персонажа</button>
    </form>
  </details>
  <section id="dialogue">
    <details class="dialogue-actions">
      <summary>Управление диалогом</summary>
      <form id="rename-dialogue" class="actions">
        <label>Название <input name="title" maxlength="160" required></label>
        <button>Сохранить название</button>
        <button type="button" id="delete-dialogue">Удалить диалог</button>
      </form>
    </details>
    <div class="actions dialogue-actions">
      <button type="button" id="copy-dialogue">Копировать диалог</button>
      <button type="button" id="export-dialogue">Скачать JSON</button>
      <button type="button" id="validate-dialogue" aria-controls="validation-report">Проверить диалог</button>
    </div>
    <form id="minimum-level" class="actions dialogue-actions">
      <label>Минимальный уровень игрока
        <input name="minimumPlayerLevel" type="number" min="1" max="2147483647" step="1" placeholder="Без ограничения">
      </label>
      <button>Сохранить порог</button>
    </form>
    <div id="validation-report" hidden>
      <p id="validation-summary" role="status"></p>
      <ul id="validation-issues" aria-label="Ошибки диалога" hidden></ul>
      <div id="validation-unreachable" hidden>
        <h3>Недостижимые реплики</h3>
        <ul id="validation-unreachable-lines"></ul>
      </div>
    </div>
    <div class="columns">
      <aside>
        <h2>Сюжетные развилки</h2>
        <ul id="branches"></ul>
        <h2>Реплики</h2>
        <ul id="lines"></ul>
        <button id="new-line">Добавить реплику</button>
      </aside>
      <div>
        <h2 id="line-heading">Реплика</h2>
        <form id="line-form">
          <label>Говорящий <select name="speakerId" required></select></label>
          <label>Текст <textarea name="text" rows="4" maxlength="4000" required></textarea></label>
          <label class="check"><input name="isEnding" type="checkbox"> Концовка</label>
          <label class="check"><input name="isStoryBranch" type="checkbox"> Сюжетная развилка</label>
          <div class="actions">
            <button>Сохранить реплику</button>
            <button type="button" id="set-start">Назначить стартом</button>
            <button type="button" id="clear-start">Снять отметку старта</button>
            <button type="button" id="delete-line">Удалить реплику</button>
          </div>
        </form>
        <div id="context" hidden>
          <h3>Входящие переходы</h3>
          <ul id="incoming"></ul>
          <h3>Варианты ответа</h3>
          <div id="choices"></div>
          <button id="new-choice">Добавить вариант</button>
        </div>
      </div>
    </div>
  </section>
  <section id="preview">
    <h2>Предпросмотр</h2>
    <form id="preview-form" class="actions">
      <label id="preview-level" hidden><span id="preview-level-caption">Уровень игрока</span>
        <input name="playerLevel" type="number" min="1" max="2147483647" step="1" disabled>
      </label>
      <button id="start-preview">Начать с первой реплики</button>
    </form>
    <div id="preview-step" aria-live="polite"></div>
    <details id="preview-history">
      <summary>История прохождений</summary>
      <div class="actions">
        <label>Сеанс <select id="preview-sessions" disabled></select></label>
        <button id="refresh-preview-history" type="button">Обновить историю</button>
      </div>
      <p id="preview-history-message" role="status"></p>
      <ol id="preview-history-steps"></ol>
    </details>
  </section>
</div>

@section Scripts {
    <script type="module" src="/editor.js"></script>
}
